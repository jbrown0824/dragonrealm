-- Dragon Realm client entry point. Wires up every UI screen and controller.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local Controllers = script:WaitForChild("Controllers")
local UI = script:WaitForChild("UI")

local App = {}
App.State = require(Controllers.State)
App.Sfx = require(Controllers.Sfx)
App.VFX = require(Controllers.VFX)
App.Movement = require(Controllers.Movement)
App.Combat = require(Controllers.Combat)
App.Animator = require(Controllers.Animator)
App.WorldView = require(Controllers.WorldView)
App.PetFollow = require(Controllers.PetFollow)
App.SpellFX = require(Controllers.SpellFX)
App.Waypoint = require(Controllers.Waypoint)
App.Sky = require(Controllers.Sky)
App.Windows = require(UI.Windows)
App.Notifications = require(UI.Notifications)
App.HUD = require(UI.HUD)
App.ClassSelect = require(UI.ClassSelect)
App.SkillTree = require(UI.SkillTree)
App.Inventory = require(UI.Inventory)
App.Shop = require(UI.Shop)
App.QuestUI = require(UI.QuestUI)
App.SeedPicker = require(UI.SeedPicker)
App.BossUI = require(UI.BossUI)
App.Help = require(UI.Help)
App.Potions = require(UI.Potions)
App.Pets = require(UI.Pets)
App.Robots = require(UI.Robots)
App.Codes = require(UI.Codes)
App.Admin = require(UI.Admin)
App.Fishing = require(UI.Fishing)
App.Training = require(UI.Training)
App.Tutorial = require(UI.Tutorial)
App.Map = require(UI.Map)
App.Store = require(UI.Store)
App.Collection = require(UI.Collection)
App.RaidUI = require(UI.RaidUI)
App.Range = require(UI.Range)

App.Windows.init()
App.Sfx.init()
App.Sky.init()
App.Notifications.init(App)
App.VFX.init(App)
App.SpellFX.init(App)
App.Movement.init(App)
App.Combat.init(App)
App.Animator.init(App)
App.PetFollow.init()
App.HUD.init(App)
App.ClassSelect.init(App)
App.SkillTree.init(App)
App.Inventory.init(App)
App.Shop.init(App)
App.QuestUI.init(App)
App.SeedPicker.init(App)
App.BossUI.init(App)
App.Help.init(App)
App.Potions.init(App)
App.Pets.init(App)
App.Robots.init(App)
App.Codes.init(App)
App.Admin.init(App)
App.Fishing.init(App)
App.Training.init(App)
App.Tutorial.init(App)
App.Waypoint.init(App)
App.Map.init(App)
App.Store.init(App)
App.Collection.init(App)
App.RaidUI.init(App)
App.Range.init(App)
task.spawn(App.WorldView.init, App)

-- Stalls and the Bot Dock ask to open a window.
Remotes.event("OpenPanel").OnClientEvent:Connect(function(name)
	if name == "Hatchery" then
		App.Pets.open("Eggs")
	elseif name == "Potions" or name == "Robots" or name == "Range" then
		App.Windows.open(name)
	end
end)

-- Load the profile last so every screen is listening when it arrives.
App.State.init()
